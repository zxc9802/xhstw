# App
NEXT_PUBLIC_APP_NAME=内容生产中台
NEXT_PUBLIC_APP_EN_NAME=Content Production Studio
LOCAL_OUTPUT_DIR=E:\content-production-studio\outputs
LOCAL_ASSET_DIR=E:\content-production-studio\assets

# Main-site SSO
# Local offline mode: skip main-site redirect and treat the browser as a logged-in local user.
DISABLE_SSO=true
MAIN_APP_URL=https://www.qycm.top
MAIN_APP_SSO_EXCHANGE_URL=https://www.qycm.top/api/external-sso/xhstw/exchange
MAIN_APP_SSO_CLIENT_SECRET=replace-with-the-xhstw-main-site-secret
APP_SESSION_SECRET=replace-with-a-unique-xhstw-session-secret

# Tencent COS finished-content storage
# local = write content library files under outputs/content-storage
CONTENT_STORAGE=local
TENCENT_COS_BUCKET=xshcp-1410143389
TENCENT_COS_REGION=ap-singapore
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=

# Copy model
COPY_MODEL_PROVIDER=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Public origin used to publish reference images for aggregation (same role as seedance PUBLIC_BASE_URL).
# If empty, the request X-Forwarded-Host / origin is used.
PUBLIC_BASE_URL=https://xhstw.qycm.top
TEMP_ASSET_SIGNING_SECRET=

# Image model
IMAGE_MODEL_PROVIDER=mock
GPT_IMAGE2_API_URL=http://14.103.147.238:19220/openApi/generate
GPT_IMAGE2_QUERY_URL=http://14.103.147.238:19220/openApi/queryResult
GPT_IMAGE2_PROJECT_CODE=
GPT_IMAGE2_ACCESS_KEY=
GPT_IMAGE2_SECRET_KEY=
GPT_IMAGE2_MODEL_ID=gpt-image2-low
GPT_IMAGE2_RESOLUTION=1K
GPT_IMAGE2_POLL_INTERVAL_MS=3000
GPT_IMAGE2_POLL_MAX_ATTEMPTS=100
OPENAI_IMAGE_PARALLEL_REQUESTS=4
NANO_BANANA_API_KEY=
NANO_BANANA_API_URL=https://api.openlux.ai/v1beta/models/gemini-3.1-flash-image:generateContent
NANO_BANANA_MODEL=gemini-3.1-flash-image
IMAGE_AGGREGATION_API_BASE_URL=http://14.103.147.238:19220
IMAGE_AGGREGATION_PROJECT_CODE=
IMAGE_AGGREGATION_ACCESS_KEY=
IMAGE_AGGREGATION_SECRET_KEY=
NANOBANANA_NEW_MODEL_ID=gemini-3.1-flash-image-preview
NANOBANANA_NEW_POLL_INTERVAL_MS=3000
NANOBANANA_NEW_POLL_MAX_ATTEMPTS=100
YUNWU_API_KEY=
YUNWU_IMAGE_URL=https://yunwu.ai/v1/images/generations
YUNWU_IMAGE_EDIT_URL=https://yunwu.ai/v1/images/edits
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_FORMAT=jpeg
YUNWU_CHAT_URL=https://yunwu.ai/v1/chat/completions
OPENLUX_API_KEY=
OPENLUX_IMAGE_URL=https://api.openlux.ai/v1/images/generations
OPENLUX_IMAGE_EDIT_URL=https://api.openlux.ai/v1/images/edits
OPENLUX_IMAGE_MODEL=gpt-image-2-c
APIYI_IMAGE_API_KEY=
APIYI_IMAGE_URL=https://api.apiyi.com/v1/images/generations
APIYI_IMAGE_EDIT_URL=https://api.apiyi.com/v1/images/edits
APIYI_IMAGE_MODEL=gpt-image-2-vip
# GPT Image 2.5: fal.ai Sunburst first (quality=high); Mixtoken remains the fallback.
FAL_KEY=
MIXTOKEN_API_KEY=
MIXTOKEN_IMAGE_URL=https://api.mixtoken.ai/v1/images/generations
MIXTOKEN_IMAGE_MODEL=gpt-image-2.5-sunburst
MIXTOKEN_IMAGE_FALLBACK_MODEL=gpt-image-2.5
# Set to true only while diagnosing an external image-provider response. Logs a redacted, size-bounded response shape.
IMAGE_RESPONSE_DEBUG=false

# Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# Video model
VIDEO_MODEL_PROVIDER=mock
SEEDANCE_API_KEY=

# TikTok public-video collection (server only; ScrapeCreators first, TikHub fallback)
SCRAPECREATORS_API_KEY=
TIKHUB_API_KEY=
# TikTok video analysis / rewrite / shooting scripts (independent from the image-copy provider)
TIKTOK_REWRITE_API_KEY=
TIKTOK_REWRITE_URL=https://api.openlux.ai/v1/chat/completions
TIKTOK_REWRITE_MODEL=gemini-3.8-flash
# Original-video analysis needs FFmpeg and FFprobe on PATH, or set their executable paths below.
TIKTOK_FFMPEG_BIN=
TIKTOK_FFPROBE_BIN=
# Optional proxy for TikTok CDN downloads only, e.g. http://127.0.0.1:11801
TIKTOK_MEDIA_PROXY=
# Missing keys never produce mock TikTok results.

# Detection
DUPLICATE_THRESHOLD=25
LOW_FLOW_RISK_THRESHOLD=70

# OpenCLI
OPENCLI_BIN=opencli.cmd

# Mock mode
MOCK_MODE=true
