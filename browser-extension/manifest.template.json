{
  "manifest_version": 3,
  "name": "小红书本机抓取助手",
  "version": "0.1.0",
  "description": "用于本机浏览器采集小红书内容的扩展助手",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.xiaohongshu.com/*", "__APP_MATCH_PATTERN__"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:3000/*", "__APP_MATCH_PATTERN__"],
      "js": ["shared/protocol.js", "app-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["shared/protocol.js", "shared/collector.js", "xhs-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {"default_title": "小红书本机抓取助手"}
}
