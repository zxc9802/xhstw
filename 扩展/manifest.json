{
    "manifest_version":  3,
    "name":  "小红书本机抓取助手",
    "version":  "0.1.33",
    "description":  "在用户自己的浏览器中执行内容生产中台下达的小红书公开页面抓取任务，并支持把小红书、抖音、TikTok 图文上传到爆款选题库2。",
    "permissions":  [
                        "storage"
                    ],
    "host_permissions":  [
                             "https://www.xiaohongshu.com/*",
                             "https://*.xiaohongshu.com/*",
                             "https://*.xhscdn.com/*",
                             "https://www.douyin.com/*",
                             "https://*.douyin.com/*",
                             "https://www.iesdouyin.com/*",
                             "https://*.iesdouyin.com/*",
                             "https://*.douyinpic.com/*",
                             "https://*.douyincdn.com/*",
                             "https://*.byteimg.com/*",
                             "https://www.tiktok.com/*",
                             "https://*.tiktok.com/*",
                             "https://*.tiktokcdn.com/*",
                             "https://*.tiktokcdn-us.com/*",
                             "https://*.tiktokcdn-eu.com/*",
                             "https://xhstw.qycm.top/*",
                             "http://127.0.0.1:3000/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://xhstw.qycm.top/*",
                                                "http://127.0.0.1:3000/*"
                                            ],
                                "js":  [
                                           "shared/protocol.js",
                                           "app-bridge.js"
                                       ],
                                "run_at":  "document_start"
                            },
                            {
                                "matches":  [
                                                "https://www.xiaohongshu.com/*"
                                            ],
                                "js":  [
                                           "shared/protocol.js",
                                           "shared/collector.js",
                                           "xhs-content.js"
                                       ],
                                "run_at":  "document_idle"
                            },
                            {
                                "matches":  [
                                                "https://www.xiaohongshu.com/*",
                                                "https://www.douyin.com/*",
                                                "https://*.douyin.com/*",
                                                "https://www.iesdouyin.com/*",
                                                "https://*.iesdouyin.com/*",
                                                "https://www.tiktok.com/*"
                                            ],
                                "js":  [
                                           "shared/collector.js",
                                           "shared/page-extract.js",
                                           "shared/library2-live.js",
                                           "library2-bar.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ],
    "action":  {
                   "default_title":  "小红书本机抓取助手"
               }
}
